{
  "$comment": "OVS house style (north star: Chris Boustedt @chriss.boustedt). build_comp.py reads this; 'studio' is the saved style from the OVS Video Editor page and overrides the house values where it says something.",
  "version": 1,
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "codec": "h264",
    "pixelFormat": "yuv420p",
    "container": "mp4"
  },
  "length": {
    "skit": {
      "maxSec": 20
    },
    "teaching": {
      "minSec": 30,
      "maxSec": 45
    },
    "hardCapSec": 45,
    "forbiddenRangeSec": [
      50,
      70
    ],
    "endHandleMaxSec": 2,
    "outro": false
  },
  "hook": {
    "windowSec": 2,
    "frame1MustAlign": [
      "visual",
      "onScreenText",
      "firstSpokenLine"
    ],
    "noGreetings": true,
    "text": {
      "from": {
        "scale": 2.4,
        "blurPx": 28,
        "opacity": 0.35
      },
      "to": {
        "scale": 1.0,
        "blurPx": 0,
        "opacity": 1.0
      },
      "durationSec": 0.35,
      "ease": "power3.out",
      "allowedRevealStyles": [
        "blur",
        "glow"
      ]
    }
  },
  "cuts": {
    "jumpCutOn": [
      "breath",
      "filler",
      "retake"
    ],
    "cutOnWordTimings": true,
    "keepBestTake": true,
    "fillerWords": [
      "um",
      "uh",
      "erm",
      "ah",
      "like",
      "you know",
      "sort of",
      "kind of",
      "basically",
      "literally",
      "so yeah"
    ],
    "talkingHead": {
      "jumpCutEverySec": [
        3,
        5
      ],
      "slowZoom": {
        "from": 1.0,
        "to": 1.08,
        "ease": "none"
      }
    },
    "brollEverySec": [
      1.5,
      2.0
    ],
    "montageEverySec": [
      0.5,
      0.7
    ],
    "maxSecWithoutChange": 2.0,
    "transitions": "hard-cut",
    "punchIn": {
      "from": 1.0,
      "to": 1.12,
      "durationSec": 0.35,
      "ease": "power3.out"
    },
    "scaleOutSettle": {
      "from": 1.25,
      "to": 1.0,
      "durationSec": 0.45,
      "ease": "power3.out"
    },
    "banned": [
      "dissolve",
      "crossfade",
      "spin",
      "glitch-pack"
    ]
  },
  "fonts": {
    "$comment": "Headings target Druk Wide (not licensed yet). Swap heading.family once licensed; everything reads from here.",
    "caption": {
      "family": "Inter",
      "weight": 900,
      "source": "google",
      "fallback": "Arial Black, sans-serif"
    },
    "heading": {
      "family": "Archivo",
      "weight": 900,
      "width": 125,
      "source": "google",
      "target": "Druk Wide",
      "targetLicensed": false,
      "fallback": "Arial Black, sans-serif"
    }
  },
  "colors": {
    "accent": "#FFD400",
    "accentInk": "#000000",
    "captionFill": "#FFFFFF",
    "captionStroke": "rgba(0,0,0,0.85)"
  },
  "captions": {
    "default": true,
    "font": "caption",
    "case": "upper",
    "sizePx": 76,
    "fill": "#FFFFFF",
    "strokePx": 3,
    "strokeColor": "rgba(0,0,0,0.85)",
    "shadow": "0 4px 18px rgba(0,0,0,0.45)",
    "box": false,
    "centerX": 540,
    "centerY": 1190,
    "chunking": "one word or short phrase (max 3 words)",
    "popIn": {
      "durationSec": 0.14,
      "ease": "back.out"
    },
    "keyword": {
      "applyTo": [
        "numbers",
        "names",
        "payoff"
      ],
      "background": "#FFD400",
      "color": "#000000",
      "radiusPx": 10,
      "paddingPx": [
        4,
        14
      ]
    },
    "handCheckNames": [
      "Mudex",
      "One Vox Studio",
      "Leederville",
      "Driftability"
    ]
  },
  "chapterPill": {
    "x": 120,
    "y": 250,
    "background": "#FFD400",
    "color": "#000000",
    "font": "caption",
    "weight": 900,
    "sizePx": 28,
    "case": "upper",
    "radiusPx": 10,
    "paddingPx": [
      8,
      16
    ],
    "changesEach": "section"
  },
  "textBehindSubject": {
    "perVideo": 1,
    "word": "hero word, one word, caps",
    "font": "heading",
    "fitWidthPct": 92,
    "centerY": 620,
    "layers": [
      "footage",
      "giantWord",
      "footageMaskedToSubject"
    ],
    "matte": {
      "tool": "rembg",
      "model": "u2net_human_seg",
      "perFrame": true
    },
    "in": {
      "scaleFrom": 1.18,
      "scaleTo": 1.0,
      "durationSec": 0.35,
      "ease": "power3.out"
    },
    "drift": {
      "scale": 0.04,
      "ease": "none",
      "untilEndOfShot": true
    }
  },
  "safeZone": {
    "xMin": 120,
    "xMax": 960,
    "yMin": 240,
    "yMax": 1260,
    "bottomThirdClear": true
  },
  "graphics": {
    "brollMatchesSpeech": true,
    "popupPerMention": 1,
    "popupMaxHoldSec": 2.0,
    "boldEffectEverySec": [
      5,
      10
    ],
    "maxSimultaneousBoldEffects": 1,
    "maxAccentMoments": 2
  },
  "audio": {
    "voicePeakDbfs": -6,
    "musicUnderVoiceDb": [
      -22,
      -18
    ],
    "noLyricsUnderSpeech": true,
    "musicLicense": "commercial-only",
    "sfx": {
      "whip": "whoosh",
      "keyword": "pop"
    }
  },
  "deliveryChecklist": [
    "Hook lands in the first 2s (visual = on-screen text = first spoken line)",
    "Length within target for the video type, never over 45s",
    "Something changes on screen at least every 2s",
    "Captions word-checked (incl. Mudex, One Vox Studio, Leederville) and inside the safe zone",
    "No more than 2 accent moments",
    "No watermarks"
  ],
  "drive": {
    "$comment": "Claude's own Drive inbox, separate from the Grok team's 'OVS Edit'. IDs pinned; transfers go through rclone (scripts/drive.sh).",
    "root": {
      "name": "OVS Claude Edit",
      "id": "13UItvrTqDvxww3rJhD5plq2lgJEOw1Hu"
    },
    "inbox": {
      "name": "1 Drop Clips",
      "id": "1_TAxCJa9V4eMYVretfStwxBfbI1mVwOQ",
      "deleteRawAfterApproval": true
    },
    "review": {
      "name": "2 For Review",
      "id": "10OBWAfflhNE8NmNv3EphOf7ie70gpfBE",
      "naming": "<video>_v<N>.mp4, <video>_v<N>_<format>.mp4, <video>_project/"
    },
    "approved": {
      "name": "3 Approved",
      "id": "1JT7bnmH6J2lSA7U8ZONTRs4k6E2c0GYC"
    },
    "sharedBroll": {
      "name": "OVS Edit/B-Roll",
      "id": "128fTy29nYqmCcs12azNBrzJSuRm3dfL6",
      "readOnly": true
    },
    "doNotTouch": [
      {
        "name": "OVS Edit (Grok team)",
        "id": "1JovciMDuW9QzS9fdwLzjGPlc2RNQF4i4"
      },
      {
        "name": "OVS Edit/1 Drop Clips (Grok team)",
        "id": "1rJLGWonNJ-xxQUbzS6TCXULxdi4sPpmr"
      },
      {
        "name": "OVS Edit/2 For Review (Grok team)",
        "id": "1b3B1NQE-Qh2wN2jH5V-kZSOQ5fk4XwVu"
      },
      {
        "name": "IMG_0400 (Grok team job)",
        "id": null
      }
    ],
    "library": {
      "name": "Library",
      "subfolders": [
        "LUTs",
        "Sounds",
        "Music",
        "Fonts",
        "Logos"
      ],
      "syncTo": "library/"
    }
  },
  "music": {
    "licensed": [],
    "policy": "No licensed music yet: ship without music."
  },
  "clipRoles": {
    "$comment": "A-roll = clips with speech; B-roll = clips without meaningful speech.",
    "brollMaxWordsPerMin": 20
  },
  "grade": {
    "$comment": "Default LUT when edit.json names none. Built in: luts/slog3_to_709.cube. Others from Drive Library/LUTs -> library/LUTs/.",
    "lut": null
  },
  "reference": {
    "$comment": "Optional: a clip with 'ref' in its name or a reel link in the note. scripts/analyze_ref.py measures cut rate, hook, pace; match what differs, keep house style for the rest.",
    "detect": {
      "fileNamePattern": "(?i)ref",
      "noteFile": "note.txt"
    }
  },
  "studio": {
    "$comment": "Written by Claude from the OVS Video Editor page (artifact db: settings/active -> styles/<id>). These defaults = the 'OVS House' preset.",
    "name": "OVS House",
    "reel": {
      "size": "9x16",
      "safe": 11,
      "focus": 50,
      "alsoWide": false,
      "perSpeaker": true
    },
    "palette": [
      {
        "name": "Key yellow",
        "hex": "#FFD400"
      },
      {
        "name": "Ink",
        "hex": "#0D0E0C"
      },
      {
        "name": "Caption white",
        "hex": "#FFFFFF"
      },
      {
        "name": "Cream paper",
        "hex": "#EFEAE0"
      },
      {
        "name": "Olive brown",
        "hex": "#303423"
      }
    ],
    "grade": {
      "lut": "none",
      "strength": 100
    },
    "captions": {
      "on": true,
      "font": "Inter",
      "weight": "900",
      "size": 4.0,
      "spacing": 2,
      "x": 50,
      "y": 62,
      "words": "3",
      "case": "upper",
      "color": "#FFFFFF",
      "keyStyle": "block",
      "accent": "#FFD400",
      "outline": "2",
      "shadow": "soft",
      "anim": "pop"
    },
    "hook": {
      "on": true
    },
    "broll": {
      "on": true,
      "push": 1.5,
      "minShot": 2.5,
      "library": "ovs",
      "rules": [
        "Only cut away when it adds something: show what I'm describing, or drive a key point home so it's impossible to miss. Never cut away just to fill time.",
        "Each b-roll scene slowly scales in (about 1-2% per second) across the whole scene: one smooth push, even when the shots change.",
        "Match the shot to what I'm saying: when I describe a place, a tool or an action, show it.",
        "Slow, calm pacing: give every shot time to breathe so the viewer can see what's happening. Never quick-fire cuts.",
        "Captions never carry over into a cutaway: new scene, new caption."
      ]
    },
    "cards": {
      "on": true,
      "bg": "alternate",
      "bgA": "#EFEAE0",
      "inkA": "#0D0E0C",
      "bgB": "#303423",
      "inkB": "#EFEAE0",
      "font": "same",
      "weight": "800",
      "size": 5.4,
      "spacing": -5.5,
      "align": "center",
      "x": 50,
      "y": 50,
      "shows": "line",
      "words": "2",
      "maxLetters": 13,
      "case": "lower",
      "punct": "hide",
      "rules": [
        "Only cut to text for a line that lands: a strong claim, the lesson, a punchline or a number. If nothing lands, stay on me.",
        "Stay on the text for the whole sentence, so the thought lands before cutting back to me.",
        "Caption it like my normal captions: one line, a few words at a time. Never more than one line on screen.",
        "Alternate the two card colours (A then B)."
      ]
    },
    "transitions": {
      "on": true,
      "list": [
        {
          "name": "Flash",
          "look": "flash2",
          "where": "broll",
          "frames": 2,
          "strength": 58,
          "sound": "",
          "landsMs": 0,
          "level": -12
        }
      ]
    },
    "audio": {
      "voicePeak": -6,
      "musicLevel": -20,
      "lowpass": "off",
      "whoosh": true,
      "pop": false,
      "track": ""
    }
  }
}